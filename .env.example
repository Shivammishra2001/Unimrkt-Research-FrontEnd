# ─────────────────────────────────────────────────────────────────────────
# Unimrkt Research Web — frontend environment configuration
# Copy to .env.local and fill in the blanks: `cp .env.example .env.local`
# ─────────────────────────────────────────────────────────────────────────

# Strapi REST API base URL, including the /api prefix. Read by the API
# client (Phase F2) client- and server-side alike — this project's Strapi
# instance lives on the LAN, not behind a private-only server URL, so this
# var is intentionally NEXT_PUBLIC_ (unlike the upstream blueprint's
# server-only STRAPI_URL). Falls back to http://localhost:1337/api when unset.
NEXT_PUBLIC_STRAPI_API_URL=http://10.50.1.2:1337/api
# Alternate LAN host (same backend, different network path) — swap the line
# above for this one if the primary IP is unreachable:
# NEXT_PUBLIC_STRAPI_API_URL=http://10.40.27.11:1337/api

# Base URL used only to prefix Strapi media/asset URLs (no /api suffix,
# no trailing slash). Must match the host in NEXT_PUBLIC_STRAPI_API_URL.
NEXT_PUBLIC_STRAPI_ASSET_URL=http://10.50.1.2:1337
# NEXT_PUBLIC_STRAPI_ASSET_URL=http://10.40.27.11:1337

# This site's own public origin — used for canonical/OpenGraph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────
# Dual-mode mocking engine (mandate #2)
# true  -> bypass the network entirely; serve local fixtures typed against
#          API_SPECIFICATION.md (safe default — works with no backend up).
# false -> issue real fetches against NEXT_PUBLIC_STRAPI_API_URL, with
#          timeouts + error boundaries for an unreachable LAN host.
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_USE_MOCKS=true

# ─────────────────────────────────────────────────────────────────────────
# Server-only secrets — NEVER prefix these with NEXT_PUBLIC_, they must
# never reach the browser bundle. Only consulted when NEXT_PUBLIC_USE_MOCKS=false.
# ─────────────────────────────────────────────────────────────────────────
STRAPI_API_TOKEN=
STRAPI_PREVIEW_TOKEN=

# Must match backend/.env exactly.
PREVIEW_SECRET=
REVALIDATE_SECRET=

# Default ISR revalidate window (seconds) for non-draft Strapi fetches.
REVALIDATE_SECONDS=3600
